# Local overrides for this machine. Git-ignored -- safe for private hostnames.
#
# This workspace serves the dev server through code-server's path proxy:
#   https://code-server-pratik01-shankar-0ec2cf.rahulsaraf.online/absproxy/5173/

# Sub-path the app is served from. Needs both leading and trailing slashes.
# Asset URLs, the React Router basename and the API base all derive from this.
VITE_BASE_PATH=/absproxy/5173/

# Hostnames Vite will serve. The leading dot covers every subdomain, so this
# keeps working if the workspace hostname changes.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.rahulsaraf.online

# Where the dev proxy forwards /api to (the backend on this machine).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Hot reload: the browser reaches the dev server over HTTPS on 443, not
# ws://localhost:5173. Comment these out when working on localhost directly.
VITE_HMR_PROTOCOL=wss
VITE_HMR_HOST=code-server-pratik01-shankar-0ec2cf.rahulsaraf.online
VITE_HMR_CLIENT_PORT=443

# VITE_API_BASE_URL is intentionally unset: it defaults to "<base>/api"
# (= /proxy/5173/api here), which is same-origin and needs no CORS.
