# Copy to .env.local (git-ignored) and adjust for your machine.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Where the frontend sends API calls.
#   /api                        -> same-origin, forwarded by the Vite dev proxy.
#                                  Best for remote/tunnelled development: no CORS.
#   http://localhost:8000/api   -> straight to the backend. Only works when the
#                                  browser runs on the same machine, and the
#                                  browser origin must be in CLINIC_CORS_ORIGINS.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests (used only when VITE_API_BASE_URL
# is relative).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Hostnames the dev server will accept, comma-separated. Vite rejects unknown
# Host headers to prevent DNS rebinding, so a tunnelled hostname must be listed.
# A leading dot covers all subdomains. Use "true" to allow any host.
# Example: localhost,127.0.0.1,.my-workspace.example.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
